---
layout: minimal.njk
title: Manage Teachers
description: Admin dashboard for managing teacher accounts
---

<div class="min-h-screen bg-base-200">
  <!-- Header -->
  <div class="navbar bg-base-100 shadow-lg">
    <div class="flex-1">
      <a href="/teacherportal/" class="btn btn-ghost normal-case text-xl">📐 Teacher Portal</a>
    </div>
    <div class="flex-none gap-2">
      <a href="/teacherportal/teacher-edit/" class="btn btn-primary btn-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Add Teacher
      </a>
      <button id="logout-btn" class="btn btn-ghost btn-sm">Logout</button>
    </div>
  </div>

  <div class="container mx-auto px-4 py-8 max-w-5xl">
    <h1 class="text-3xl font-bold mb-8">Teachers</h1>

    <!-- Alert messages -->
    <div id="alert-container" class="mb-4"></div>

    <!-- Loading state -->
    <div id="loading" class="flex justify-center items-center py-12">
      <span class="loading loading-spinner loading-lg"></span>
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden text-center py-12">
      <div class="text-6xl mb-4">🧑‍🏫</div>
      <h2 class="text-2xl font-bold mb-2">No teachers yet</h2>
      <p class="text-gray-600 mb-6">Add your first teacher to get started.</p>
      <a href="/teacherportal/teacher-edit/" class="btn btn-primary">Add Teacher</a>
    </div>

    <!-- Teachers table -->
    <div id="teachers-table-container" class="hidden overflow-x-auto">
      <table class="table bg-base-100 shadow">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>District</th>
            <th>Role</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="teachers-body"></tbody>
      </table>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<dialog id="delete-modal" class="modal">
  <div class="modal-box">
    <h3 class="font-bold text-lg mb-4">Remove Teacher?</h3>
    <p class="mb-4">This will revoke <strong id="delete-teacher-name"></strong>'s login and delete their record. This cannot be undone.</p>
    <input type="hidden" id="delete-teacher-id">
    <input type="hidden" id="delete-teacher-auth-id">
    <div class="modal-action">
      <button id="confirm-delete-btn" class="btn btn-error">
        <span id="delete-text">Remove</span>
        <span id="delete-spinner" class="loading loading-spinner hidden"></span>
      </button>
      <form method="dialog">
        <button class="btn">Cancel</button>
      </form>
    </div>
  </div>
</dialog>

<script type="module">
import { requireAuth, logout, isAdmin } from '/assets/js/teacher-portal-auth-guard.js';
import { getAllTeachers, deleteTeacherRow } from '/assets/js/teachers-db.js';
import { supabase } from '/assets/js/lessons-supabase-client.js';

// Auth guard -- this page is admin-only, not just authenticated
const user = await requireAuth();
const adminUser = await isAdmin();
if (!adminUser) {
  window.location.href = '/teacherportal/';
  throw new Error('Admin access required');
}

// Logout button
document.getElementById('logout-btn').addEventListener('click', logout);

// Alert helper
function showAlert(message, type = 'info') {
  const container = document.getElementById('alert-container');
  const alert = document.createElement('div');
  alert.className = `alert alert-${type} shadow-lg`;
  alert.innerHTML = `<span>${message}</span>`;
  container.appendChild(alert);
  setTimeout(() => alert.remove(), 5000);
}

function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text || '';
  return div.innerHTML;
}

// supabase-js only surfaces a generic "non-2xx" message on Edge Function
// errors -- the real message is in the response body, under error.context.
async function extractFunctionErrorMessage(error) {
  if (error?.context && typeof error.context.json === 'function') {
    try {
      const body = await error.context.json();
      if (body?.error) return body.error;
    } catch (_) {
      // fall through to generic message below
    }
  }
  return error?.message || 'Unknown error';
}

function roleBadge(role) {
  const colors = { admin: 'badge-error', district_admin: 'badge-warning', teacher: 'badge-ghost' };
  return `<div class="badge ${colors[role] || 'badge-ghost'}">${escapeHtml(role)}</div>`;
}

// Load and display teachers
async function loadTeachers() {
  const loading = document.getElementById('loading');
  const emptyState = document.getElementById('empty-state');
  const tableContainer = document.getElementById('teachers-table-container');

  loading.classList.remove('hidden');
  emptyState.classList.add('hidden');
  tableContainer.classList.add('hidden');

  const result = await getAllTeachers();

  loading.classList.add('hidden');

  if (!result.success) {
    showAlert(result.error?.message || 'Failed to load teachers', 'error');
    return;
  }

  if (result.data.length === 0) {
    emptyState.classList.remove('hidden');
    return;
  }

  tableContainer.classList.remove('hidden');
  const tbody = document.getElementById('teachers-body');
  tbody.innerHTML = result.data.map(teacher => {
    const isSelf = teacher.auth_id === user.id;
    const districtName = teacher.districts?.name || (teacher.role === 'admin' ? 'All Districts' : '—');
    return `
      <tr>
        <td>${escapeHtml(teacher.name)}</td>
        <td>${escapeHtml(teacher.email)}</td>
        <td>${escapeHtml(districtName)}</td>
        <td>${roleBadge(teacher.role)}</td>
        <td class="text-right">
          <button
            class="btn btn-sm btn-outline resend-btn"
            data-email="${teacher.email}"
          >Resend Invite</button>
          <a href="/teacherportal/teacher-edit/?id=${teacher.id}" class="btn btn-sm btn-outline btn-primary">Edit</a>
          <button
            class="btn btn-sm btn-outline btn-error delete-btn"
            data-id="${teacher.id}"
            data-auth-id="${teacher.auth_id}"
            data-name="${escapeHtml(teacher.name)}"
            ${isSelf ? 'disabled title="You cannot remove your own account"' : ''}
          >Remove</button>
        </td>
      </tr>
    `;
  }).join('');

  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.getElementById('delete-teacher-id').value = btn.dataset.id;
      document.getElementById('delete-teacher-auth-id').value = btn.dataset.authId;
      document.getElementById('delete-teacher-name').textContent = btn.dataset.name;
      document.getElementById('delete-modal').showModal();
    });
  });

  document.querySelectorAll('.resend-btn').forEach(btn => {
    btn.addEventListener('click', () => resendInvite(btn));
  });
}

// Resend an invite email to an existing (likely still-pending) teacher
async function resendInvite(btn) {
  const email = btn.dataset.email;
  const originalText = btn.textContent;

  btn.disabled = true;
  btn.textContent = 'Sending…';

  try {
    const redirectTo = `${window.location.origin}/teacherportal/reset-password/?email=${encodeURIComponent(email)}&type=invite`;
    const { data, error } = await supabase.functions.invoke('teacherportal-admin', {
      body: { action: 'resend', email, redirectTo },
    });

    if (error) throw new Error(await extractFunctionErrorMessage(error));
    if (data?.error) throw new Error(data.error);

    showAlert(`Invite resent to ${email}`, 'success');
  } catch (err) {
    showAlert(err.message || 'Failed to resend invite', 'error');
  } finally {
    btn.disabled = false;
    btn.textContent = originalText;
  }
}

// Confirm delete
document.getElementById('confirm-delete-btn').addEventListener('click', async () => {
  const id = document.getElementById('delete-teacher-id').value;
  const authId = document.getElementById('delete-teacher-auth-id').value;

  const deleteBtn = document.getElementById('confirm-delete-btn');
  const deleteText = document.getElementById('delete-text');
  const deleteSpinner = document.getElementById('delete-spinner');

  deleteBtn.disabled = true;
  deleteText.classList.add('hidden');
  deleteSpinner.classList.remove('hidden');

  try {
    // Remove the teachers row FIRST -- its auth_id foreign key has no
    // cascade rule, so deleting the auth user first would be blocked by
    // Postgres while this row still references it.
    const rowResult = await deleteTeacherRow(id);
    if (!rowResult.success) {
      throw new Error(rowResult.error?.message || 'Failed to remove teacher record');
    }

    // Then revoke the login via the Edge Function (privileged operation)
    const { data, error } = await supabase.functions.invoke('teacherportal-admin', {
      body: { action: 'remove', authId },
    });

    if (error) {
      const msg = await extractFunctionErrorMessage(error);
      throw new Error(`Teacher record removed, but revoking their login failed: ${msg}`);
    }
    if (data?.error) {
      throw new Error(`Teacher record removed, but revoking their login failed: ${data.error}`);
    }

    document.getElementById('delete-modal').close();
    showAlert('Teacher removed', 'success');
    loadTeachers();
  } catch (err) {
    document.getElementById('delete-modal').close();
    showAlert(err.message || 'Failed to remove teacher', 'error');
  } finally {
    deleteBtn.disabled = false;
    deleteText.classList.remove('hidden');
    deleteSpinner.classList.add('hidden');
  }
});

loadTeachers();
</script>
