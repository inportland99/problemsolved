---
layout: minimal.njk
title: Lesson
description: View math lesson details
---

<div class="min-h-screen bg-base-200">
  <!-- Navbar -->
  <div class="navbar bg-base-100 shadow-lg">
    <div class="flex-1">
      <a href="/teacherportal/lesson-index/" class="btn btn-ghost normal-case text-xl">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Lessons
      </a>
    </div>
    <div class="flex-none gap-2">
      <span id="user-badge" class="text-sm text-base-content/70 hidden sm:inline"></span>
      <a id="edit-link" href="#" class="btn btn-primary btn-sm hidden">Edit</a>
      <button id="logout-btn" class="btn btn-ghost btn-sm">Logout</button>
    </div>
  </div>

  <!-- Loading -->
  <div id="loading" class="flex justify-center items-center py-12">
    <span class="loading loading-spinner loading-lg"></span>
  </div>

  <!-- Content -->
  <div id="content" class="hidden container mx-auto px-4 py-8 max-w-3xl">
    <div id="alert-container" class="mb-4"></div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h1 id="lesson-title" class="text-3xl font-bold"></h1>
        <p id="lesson-content-name" class="hidden text-sm text-base-content/70 mb-2"></p>

        <!-- Math Content tags (Grade · Domain · Topic, primary starred) -->
        <div id="taxonomy-container" class="hidden flex flex-wrap gap-1.5 mb-4 text-sm"></div>

        <!-- Diagram -->
        <div id="diagram-container" class="my-4 hidden">
          <img id="lesson-diagram" src="" alt="Lesson diagram" class="max-w-full h-auto rounded-lg shadow cursor-zoom-in hover:opacity-90 transition" />
          <p class="text-xs text-gray-500 mt-1">Click the image to view it full screen</p>
        </div>

        <!-- Description -->
        <div class="mb-6 mt-4">
          <p class="text-sm font-semibold text-gray-600 mb-2">Description</p>
          <div class="p-4 bg-base-200 rounded-lg">
            <p id="lesson-task" class="whitespace-pre-wrap"></p>
          </div>
        </div>

        <!-- Launch Details -->
        <div id="launch-container" class="mb-6 hidden">
          <p class="text-sm font-semibold text-gray-600 mb-2">Launch Details</p>
          <div class="p-4 bg-base-200 rounded-lg">
            <p id="lesson-launch" class="whitespace-pre-wrap"></p>
          </div>
        </div>

        <!-- Anticipated Strategies -->
        <div id="strategies-container" class="mb-6 hidden">
          <p class="text-sm font-semibold text-gray-600 mb-2">Anticipated Strategies</p>
          <ul id="lesson-strategies" class="list-disc list-inside space-y-1 p-4 bg-base-200 rounded-lg"></ul>
        </div>

        <!-- Questions -->
        <div id="questions-container" class="mb-6 hidden">
          <p class="text-sm font-semibold text-gray-600 mb-2">Questions</p>
          <ul id="lesson-questions" class="space-y-2 p-4 bg-base-200 rounded-lg"></ul>
        </div>

        <!-- Author & Date -->
        <div class="text-sm text-gray-500 border-t pt-4">
          <span id="lesson-author"></span> · <span id="lesson-date"></span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Fullscreen image lightbox -->
<dialog id="image-lightbox" class="modal p-0">
  <div class="modal-box max-w-none w-screen h-screen max-h-screen rounded-none bg-black/95 flex items-center justify-center p-4">
    <div class="absolute top-4 right-4 flex gap-2 z-10">
      <button id="fullscreen-btn" type="button" class="btn btn-sm btn-outline text-white border-white/40 hover:bg-white/10 hover:text-white">Fullscreen</button>
      <button id="close-lightbox-btn" type="button" class="btn btn-sm btn-circle btn-outline text-white border-white/40 hover:bg-white/10 hover:text-white">✕</button>
    </div>
    <img id="lightbox-img" src="" alt="Lesson diagram (full screen)" class="max-w-full max-h-full object-contain" />
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<script type="module">
import { requireAuth, logout, renderUserBadge } from '/assets/js/teacher-portal-auth-guard.js';
import { getLessonById } from '/assets/js/lessons-db.js';

await requireAuth();
renderUserBadge('user-badge');
document.getElementById('logout-btn').addEventListener('click', logout);

const urlParams = new URLSearchParams(window.location.search);
const lessonId = urlParams.get('id');

if (!lessonId) {
  window.location.href = '/teacherportal/lesson-index/';
}

function showAlert(message, type = 'info') {
  const container = document.getElementById('alert-container');
  const el = document.createElement('div');
  el.className = `alert alert-${type} shadow-lg`;
  el.innerHTML = `<span>${message}</span>`;
  container.appendChild(el);
  setTimeout(() => el.remove(), 5000);
}

function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

function formatDate(dateString) {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}

function renderMathContentTags(mathContent) {
  if (!mathContent || mathContent.length === 0) return;
  const sorted = [...mathContent].sort((a, b) => (b.isPrimary) - (a.isPrimary));
  document.getElementById('taxonomy-container').innerHTML = sorted.map(m => {
    const label = [m.gradeCourse, m.domain, m.topic].filter(Boolean).join(' \u00b7 ');
    return `<span class="badge badge-outline">${m.isPrimary ? '\u2b50 ' : ''}${escapeHtml(label)}</span>`;
  }).join(' ');
  document.getElementById('taxonomy-container').classList.remove('hidden');
}

const QUESTION_TYPE_META = {
  extension: {
    label: 'Extension',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7a3 3 0 11-3.75-3.75" /></svg>'
  },
  probing: {
    label: 'Probing',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>'
  },
  connecting: {
    label: 'Connecting',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" /></svg>'
  }
};

function renderQuestions(questions) {
  return questions.map(q => {
    const meta = QUESTION_TYPE_META[q.type] || QUESTION_TYPE_META.connecting;
    return `<li class="flex items-start gap-2"><span class="mt-0.5 shrink-0" title="${meta.label}">${meta.icon}</span><span>${escapeHtml(q.text)}</span></li>`;
  }).join('');
}

// Fullscreen image lightbox
const lightbox = document.getElementById('image-lightbox');
const lightboxImg = document.getElementById('lightbox-img');
const fullscreenBtn = document.getElementById('fullscreen-btn');

document.getElementById('lesson-diagram').addEventListener('click', () => {
  lightboxImg.src = document.getElementById('lesson-diagram').src;
  lightbox.showModal();
});

document.getElementById('close-lightbox-btn').addEventListener('click', () => {
  lightbox.close();
});

fullscreenBtn.addEventListener('click', () => {
  if (document.fullscreenElement) {
    document.exitFullscreen();
  } else {
    lightboxImg.requestFullscreen?.().catch(() => {});
  }
});

document.addEventListener('fullscreenchange', () => {
  fullscreenBtn.textContent = document.fullscreenElement ? 'Exit Fullscreen' : 'Fullscreen';
});

lightbox.addEventListener('close', () => {
  if (document.fullscreenElement) {
    document.exitFullscreen();
  }
});

document.getElementById('edit-link').href = `/teacherportal/lesson-edit/?id=${lessonId}`;
document.getElementById('edit-link').classList.remove('hidden');

const result = await getLessonById(lessonId);
document.getElementById('loading').classList.add('hidden');

if (!result.success) {
  showAlert(result.error?.message || 'Failed to load lesson', 'error');
} else {
  const lesson = result.data;

  document.getElementById('lesson-title').textContent = lesson.title || lesson.learning_goal;

  if (lesson.lesson_content_name) {
    document.getElementById('lesson-content-name').textContent = lesson.lesson_content_name;
    document.getElementById('lesson-content-name').classList.remove('hidden');
  }

  document.getElementById('lesson-task').textContent = lesson.task;

  if (lesson.diagram_url) {
    document.getElementById('lesson-diagram').src = lesson.diagram_url;
    document.getElementById('diagram-container').classList.remove('hidden');
  }

  if (lesson.launch_details) {
    document.getElementById('lesson-launch').textContent = lesson.launch_details;
    document.getElementById('launch-container').classList.remove('hidden');
  }

  if (lesson.anticipated_strategies?.length > 0) {
    document.getElementById('lesson-strategies').innerHTML =
      lesson.anticipated_strategies.map(s => `<li>${escapeHtml(s)}</li>`).join('');
    document.getElementById('strategies-container').classList.remove('hidden');
  }

  if (lesson.questions?.length > 0) {
    document.getElementById('lesson-questions').innerHTML = renderQuestions(lesson.questions);
    document.getElementById('questions-container').classList.remove('hidden');
  }

  renderMathContentTags(lesson.mathContent);

  document.getElementById('lesson-author').textContent = lesson.author;
  document.getElementById('lesson-date').textContent = formatDate(lesson.created_at);

  document.getElementById('content').classList.remove('hidden');
}
</script>
