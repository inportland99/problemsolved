---
layout: minimal.njk
title: Lesson Observation Form
description: Lesson observation form for classroom visits
---

<div class="min-h-screen bg-base-200">
  <!-- Navbar -->
  <div class="navbar bg-base-100 shadow-lg">
    <div class="flex-1">
      <a href="/teacherportal/observation-index/" class="btn btn-ghost normal-case text-xl">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Observations
      </a>
    </div>
    <div class="flex-none gap-2">
      <span id="user-badge" class="text-sm text-base-content/70 hidden sm:inline"></span>
      <button id="logout-btn" class="btn btn-ghost btn-sm">Logout</button>
    </div>
  </div>

  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <h1 id="page-title" class="text-3xl font-bold mb-8">New Observation</h1>

    <!-- Alert messages -->
    <div id="alert-container" class="mb-4"></div>

    <form id="observation-form" class="space-y-6">
<!-- Meta fields -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="form-control">
          <label class="label"><span class="label-text font-semibold">Teacher</span></label>
          <select id="teacherId" class="select select-bordered w-full">
            <option value="">Select teacher</option>
          </select>
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text font-semibold">Date</span></label>
          <input type="date" id="obsDate" class="input input-bordered">
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text font-semibold">Observer's Name</span></label>
          <input type="text" id="observerName" class="input input-bordered" placeholder="Enter observer name">
        </div>
        <div class="form-control md:col-span-2">
          <label class="label"><span class="label-text font-semibold">Portal Lesson (optional)</span></label>
          <select id="mathLessonId" class="select select-bordered w-full">
            <option value="">None — not in the lesson library</option>
          </select>
          <label class="label">
            <span class="label-text-alt">If you pick a library lesson, its title and primary Math Content are filled in (you can still change them).</span>
          </label>
        </div>
        <div class="form-control md:col-span-2">
          <label class="label"><span class="label-text font-semibold">Lesson title</span></label>
          <input type="text" id="lesson" class="input input-bordered" placeholder="What was the lesson called in class?">
        </div>
      </div>

      <!-- Math Content (single taxonomy tag) -->
      <div class="form-control">
        <label class="label"><span class="label-text font-semibold">Math Content</span></label>
        <p class="text-sm text-base-content/60 mb-2">Pick one Grade/Course · Domain · Math Topic for this observation. Filter or search, then select a topic.</p>
        <div id="taxonomy-picker-container"></div>
      </div>

      <div class="divider"></div>

      <!-- Planning -->
      <div class="flex flex-col md:flex-row gap-4 items-start">
        <div class="form-control shrink-0 w-full md:w-1/3">
          <label class="label"><span class="label-text font-semibold">Planning</span></label>
          <div class="flex items-center gap-2">
            <span class="text-xs text-gray-500">0</span>
            <input type="range" id="planningScore" min="0" max="5" step="0.1" value="0" class="range range-primary flex-1">
            <span class="text-xs text-gray-500">5</span>
          </div>
        </div>
        <div class="form-control flex-1 w-full">
          <label class="label"><span class="label-text">Notes</span></label>
<textarea id="planningNotes" rows="4" class="textarea textarea-bordered w-full" placeholder="Notes on planning…"></textarea>
        </div>
      </div>

      <!-- Launch -->
      <div class="flex flex-col md:flex-row gap-4 items-start">
        <div class="form-control shrink-0 w-full md:w-1/3">
          <label class="label"><span class="label-text font-semibold">Launch</span></label>
          <div class="flex items-center gap-2">
            <span class="text-xs text-gray-500">0</span>
            <input type="range" id="launchScore" min="0" max="5" step="0.1" value="0" class="range range-primary flex-1">
            <span class="text-xs text-gray-500">5</span>
          </div>
        </div>
        <div class="form-control flex-1 w-full">
          <label class="label"><span class="label-text">Notes</span></label>
<textarea id="launchNotes" rows="4" class="textarea textarea-bordered w-full" placeholder="Notes on launch…"></textarea>
        </div>
      </div>

      <!-- Problem Solving -->
      <div class="flex flex-col md:flex-row gap-4 items-start">
        <div class="form-control shrink-0 w-full md:w-1/3">
          <label class="label"><span class="label-text font-semibold">Problem Solving</span></label>
          <div class="flex items-center gap-2">
            <span class="text-xs text-gray-500">0</span>
            <input type="range" id="problemSolvingScore" min="0" max="5" step="0.1" value="0" class="range range-primary flex-1">
            <span class="text-xs text-gray-500">5</span>
          </div>
        </div>
        <div class="form-control flex-1 w-full">
          <label class="label"><span class="label-text">Notes</span></label>
<textarea id="problemSolvingNotes" rows="4" class="textarea textarea-bordered w-full" placeholder="Notes on problem solving…"></textarea>
        </div>
      </div>

      <!-- Closing -->
      <div class="flex flex-col md:flex-row gap-4 items-start">
        <div class="form-control shrink-0 w-full md:w-1/3">
          <label class="label"><span class="label-text font-semibold">Closing</span></label>
          <div class="flex items-center gap-2">
            <span class="text-xs text-gray-500">0</span>
            <input type="range" id="closingScore" min="0" max="5" step="0.1" value="0" class="range range-primary flex-1">
            <span class="text-xs text-gray-500">5</span>
          </div>
        </div>
        <div class="form-control flex-1 w-full">
          <label class="label"><span class="label-text">Notes</span></label>
<textarea id="closingNotes" rows="4" class="textarea textarea-bordered w-full" placeholder="Notes on closing…"></textarea>
        </div>
      </div>

      <!-- Additional Notes -->
      <div class="form-control">
        <label class="label"><span class="label-text font-semibold">Additional Notes</span></label>
        <textarea id="additionalNotes" class="textarea textarea-bordered" placeholder="Any additional notes…"></textarea>
      </div>

      <!-- Actions -->
      <div class="flex gap-4 pt-4">
        <button type="submit" id="save-btn" class="btn btn-primary flex-1">
          <span id="save-text">Save Observation</span>
          <span id="save-spinner" class="loading loading-spinner hidden"></span>
        </button>
      </div>
    </form>
  </div>
</div>

<script type="module">
import { requireAuth, logout, renderUserBadge } from '/assets/js/teacher-portal-auth-guard.js';
import { createObservation, updateObservation, getObservationById } from '/assets/js/observations-db.js';
import { getTeacherRoster } from '/assets/js/teachers-db.js';
import { getAllLessons } from '/assets/js/lessons-db.js';
import { getTaxonomy } from '/assets/js/taxonomy-db.js';
import { renderTaxonomyPicker } from '/assets/js/math-taxonomy-picker.js';

await requireAuth();
renderUserBadge('user-badge');
document.getElementById('logout-btn').addEventListener('click', logout);

function showAlert(message, type = 'info') {
  const container = document.getElementById('alert-container');
  const alert = document.createElement('div');
  alert.className = `alert alert-${type} shadow-lg`;
  alert.innerHTML = `<span>${message}</span>`;
  container.appendChild(alert);
  setTimeout(() => alert.remove(), 5000);
}

/** Primary taxonomy id from a lesson's mathContent, else first tag. */
function primaryTaxonomyIdFromLesson(lesson) {
  if (!lesson?.mathContent?.length) return null;
  const primary = lesson.mathContent.find(t => t.isPrimary);
  return (primary || lesson.mathContent[0])?.taxonomyId ?? null;
}

// Teachers
const rosterResult = await getTeacherRoster();
if (rosterResult.success) {
  const teacherSelect = document.getElementById('teacherId');
  rosterResult.data.forEach(t => {
    const opt = document.createElement('option');
    opt.value = t.id;
    opt.textContent = t.name;
    teacherSelect.appendChild(opt);
  });
}

// Portal lessons (optional link)
const lessonsResult = await getAllLessons();
const LESSONS = lessonsResult.success ? lessonsResult.data : [];
if (!lessonsResult.success) {
  showAlert('Failed to load portal lessons', 'error');
}
const lessonSelect = document.getElementById('mathLessonId');
const lessonsById = new Map();
LESSONS.forEach(lesson => {
  lessonsById.set(lesson.id, lesson);
  const opt = document.createElement('option');
  opt.value = lesson.id;
  const district = lesson.districts?.name ? ` · ${lesson.districts.name}` : '';
  opt.textContent = `${lesson.title || 'Untitled'}${district}`;
  lessonSelect.appendChild(opt);
});

// Math Content picker (exactly one tag)
const taxonomyResult = await getTaxonomy();
const TAXONOMY = taxonomyResult.success ? taxonomyResult.data : [];
const taxonomyById = new Map(TAXONOMY.map(row => [row.id, row]));
if (!taxonomyResult.success) {
  showAlert('Failed to load Math Content taxonomy', 'error');
}
const taxonomyPicker = renderTaxonomyPicker(
  document.getElementById('taxonomy-picker-container'),
  TAXONOMY,
  {},
  { singleSelect: true }
);

// Autofill title + taxonomy when a library lesson is chosen
lessonSelect.addEventListener('change', () => {
  const lesson = lessonsById.get(lessonSelect.value);
  if (!lesson) return;
  const titleInput = document.getElementById('lesson');
  if (!titleInput.value.trim() || titleInput.dataset.autofilled === '1') {
    titleInput.value = lesson.title || '';
    titleInput.dataset.autofilled = '1';
  }
  const taxId = primaryTaxonomyIdFromLesson(lesson);
  if (taxId != null) {
    taxonomyPicker.setSelection({ taxonomyIds: [taxId] });
  }
});
document.getElementById('lesson').addEventListener('input', (e) => {
  e.target.dataset.autofilled = '0';
});

const urlParams = new URLSearchParams(window.location.search);
const obsId = urlParams.get('id');

document.getElementById('obsDate').valueAsDate = new Date();

if (obsId) {
  document.getElementById('page-title').textContent = 'Edit Observation';
  document.getElementById('save-text').textContent = 'Update Observation';

  const result = await getObservationById(obsId);
  if (result.success) {
    const obs = result.data;
    document.getElementById('teacherId').value = obs.observed_teacher_id || '';
    document.getElementById('lesson').value = obs.lesson || '';
    document.getElementById('lesson').dataset.autofilled = '0';
    document.getElementById('obsDate').value = obs.observation_date || '';
    document.getElementById('observerName').value = obs.observer_name || '';
    document.getElementById('planningScore').value = obs.planning_score || 0;
    document.getElementById('planningNotes').value = obs.planning_notes || '';
    document.getElementById('launchScore').value = obs.launch_score || 0;
    document.getElementById('launchNotes').value = obs.launch_notes || '';
    document.getElementById('problemSolvingScore').value = obs.problem_solving_score || 0;
    document.getElementById('problemSolvingNotes').value = obs.problem_solving_notes || '';
    document.getElementById('closingScore').value = obs.closing_score || 0;
    document.getElementById('closingNotes').value = obs.closing_notes || '';
    document.getElementById('additionalNotes').value = obs.additional_notes || '';

    if (obs.math_lesson_id) {
      lessonSelect.value = obs.math_lesson_id;
      // Ensure option exists even if the lesson is no longer in the visible list
      if (lessonSelect.value !== obs.math_lesson_id) {
        const opt = document.createElement('option');
        opt.value = obs.math_lesson_id;
        opt.textContent = obs.linkedLessonTitle || 'Linked lesson';
        lessonSelect.appendChild(opt);
        lessonSelect.value = obs.math_lesson_id;
      }
    }

    if (obs.taxonomy_id) {
      taxonomyPicker.setSelection({ taxonomyIds: [obs.taxonomy_id] });
    }
  } else {
    showAlert('Failed to load observation', 'error');
  }
}

document.getElementById('observation-form').addEventListener('submit', async (e) => {
  e.preventDefault();

  const saveBtn = document.getElementById('save-btn');
  const saveText = document.getElementById('save-text');
  const saveSpinner = document.getElementById('save-spinner');

  saveBtn.disabled = true;
  saveText.classList.add('hidden');
  saveSpinner.classList.remove('hidden');

  try {
    const teacherSelect = document.getElementById('teacherId');
    const selectedOption = teacherSelect.options[teacherSelect.selectedIndex];
    const selection = taxonomyPicker.getSelection();
    const taxonomyId = selection.taxonomyIds[0] ?? null;
    const taxRow = taxonomyId != null ? taxonomyById.get(taxonomyId) : null;

    const data = {
      observedTeacherId: teacherSelect.value || null,
      teacherName: selectedOption && selectedOption.value ? selectedOption.textContent.trim() : '',
      // Denormalize grade label from taxonomy for older list UIs / exports
      gradeCourse: taxRow?.gradeCourse || null,
      lesson: document.getElementById('lesson').value.trim(),
      observationDate: document.getElementById('obsDate').value,
      observerName: document.getElementById('observerName').value.trim(),
      planningScore: parseFloat(document.getElementById('planningScore').value),
      planningNotes: document.getElementById('planningNotes').value.trim(),
      launchScore: parseFloat(document.getElementById('launchScore').value),
      launchNotes: document.getElementById('launchNotes').value.trim(),
      problemSolvingScore: parseFloat(document.getElementById('problemSolvingScore').value),
      problemSolvingNotes: document.getElementById('problemSolvingNotes').value.trim(),
      closingScore: parseFloat(document.getElementById('closingScore').value),
      closingNotes: document.getElementById('closingNotes').value.trim(),
      additionalNotes: document.getElementById('additionalNotes').value.trim(),
      mathLessonId: document.getElementById('mathLessonId').value || null,
      taxonomyId
    };

    const result = obsId ? await updateObservation(obsId, data) : await createObservation(data);

    if (result.success) {
      showAlert(obsId ? 'Observation updated!' : 'Observation saved!', 'success');
      setTimeout(() => {
        window.location.href = '/teacherportal/observation-index/';
      }, 1000);
    } else {
      showAlert(result.error?.message || 'Failed to save observation', 'error');
    }
  } finally {
    saveBtn.disabled = false;
    saveText.classList.remove('hidden');
    saveSpinner.classList.add('hidden');
  }
});
</script>
