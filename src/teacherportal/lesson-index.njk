---
layout: minimal.njk
title: Math Lessons Library
description: Browse and manage math lessons for problem-based learning
---

<div class="min-h-screen bg-base-200">
  <!-- Header -->
  <div class="navbar bg-base-100 shadow-lg">
    <div class="flex-1">
      <a href="/teacherportal/" class="btn btn-ghost normal-case text-xl">📐 Math Lessons</a>
    </div>
    <div class="flex-none gap-2">
      <span id="user-badge" class="text-sm text-base-content/70 hidden sm:inline"></span>
      <a href="/teacherportal/observation-index/" class="btn btn-ghost btn-sm">Observations</a>
      <a href="/teacherportal/lesson-edit/" class="btn btn-primary btn-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        New Lesson
      </a>
      <button id="logout-btn" class="btn btn-ghost btn-sm">Logout</button>
    </div>
  </div>

  <div class="container mx-auto px-4 py-8 max-w-6xl">
    
    <!-- Alert messages -->
    <div id="alert-container" class="mb-4"></div>

    <!-- Loading state -->
    <div id="loading" class="flex justify-center items-center py-12">
      <span class="loading loading-spinner loading-lg"></span>
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden text-center py-12">
      <div class="text-6xl mb-4">📐</div>
      <h2 class="text-2xl font-bold mb-2">No lessons yet</h2>
      <p class="text-gray-600 mb-6">Start by creating your first math lesson!</p>
      <a href="/teacherportal/lesson-edit/" class="btn btn-primary">Create First Lesson</a>
    </div>

    <!-- Lessons Table -->
    <div id="lessons-table-container" class="hidden overflow-x-auto">
      <table class="table bg-base-100 shadow">
        <thead>
          <tr>
            <th class="cursor-pointer select-none" data-sort="title">Title<span class="sort-indicator"></span></th>
            <th class="cursor-pointer select-none" data-sort="lessonContentName">Lesson Content Name<span class="sort-indicator"></span></th>
            <th class="cursor-pointer select-none" data-sort="district">District<span class="sort-indicator"></span></th>
            <th>Diagram</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="lessons-body"></tbody>
      </table>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<dialog id="delete-modal" class="modal">
  <div class="modal-box">
    <h3 class="font-bold text-lg mb-4">Delete Lesson?</h3>
    <p class="mb-4">Are you sure you want to delete this lesson? This action cannot be undone.</p>
    <input type="hidden" id="delete-lesson-id">
    <div class="modal-action">
      <button id="confirm-delete-btn" class="btn btn-error">Delete</button>
      <form method="dialog">
        <button class="btn">Cancel</button>
      </form>
    </div>
  </div>
</dialog>

<script type="module">
import { requireAuth, logout, isAdmin, renderUserBadge } from '/assets/js/teacher-portal-auth-guard.js';
import { getAllLessons, deleteLesson } from '/assets/js/lessons-db.js';

// Auth guard — redirects to login if not authenticated
const user = await requireAuth();
const adminUser = await isAdmin();
renderUserBadge('user-badge');

// Logout button
document.getElementById('logout-btn').addEventListener('click', logout);

// Alert helper
function showAlert(message, type = 'info') {
  const container = document.getElementById('alert-container');
  const alert = document.createElement('div');
  alert.className = `alert alert-${type} shadow-lg`;
  alert.innerHTML = `<span>${message}</span>`;
  container.appendChild(alert);
  
  setTimeout(() => {
    alert.remove();
  }, 5000);
}

function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text || '';
  return div.innerHTML;
}

// Display helpers (shared by rendering and sorting so both stay consistent)
function displayTitle(lesson) {
  return lesson.title || lesson.learning_goal || '';
}
function displayContentName(lesson) {
  return lesson.lesson_content_name || '';
}
function displayDistrict(lesson) {
  return lesson.districts?.name || 'All Districts';
}

let allLessons = [];
const sortState = { field: 'title', direction: 'asc' };

function sortLessons() {
  const getters = {
    title: displayTitle,
    lessonContentName: displayContentName,
    district: displayDistrict
  };
  const getValue = getters[sortState.field];
  const sorted = [...allLessons].sort((a, b) => {
    const cmp = getValue(a).localeCompare(getValue(b), undefined, { sensitivity: 'base' });
    return sortState.direction === 'asc' ? cmp : -cmp;
  });
  return sorted;
}

function updateSortIndicators() {
  document.querySelectorAll('th[data-sort]').forEach(th => {
    const indicator = th.querySelector('.sort-indicator');
    if (th.dataset.sort === sortState.field) {
      indicator.textContent = sortState.direction === 'asc' ? ' ▲' : ' ▼';
    } else {
      indicator.textContent = '';
    }
  });
}

document.querySelectorAll('th[data-sort]').forEach(th => {
  th.addEventListener('click', () => {
    const field = th.dataset.sort;
    if (sortState.field === field) {
      sortState.direction = sortState.direction === 'asc' ? 'desc' : 'asc';
    } else {
      sortState.field = field;
      sortState.direction = 'asc';
    }
    renderLessons();
  });
});

// Load lessons from the database
async function loadLessons() {
  const loading = document.getElementById('loading');
  const emptyState = document.getElementById('empty-state');
  const tableContainer = document.getElementById('lessons-table-container');

  loading.classList.remove('hidden');
  emptyState.classList.add('hidden');
  tableContainer.classList.add('hidden');

  const result = await getAllLessons();

  loading.classList.add('hidden');

  if (!result.success) {
    showAlert(result.error?.message || 'Failed to load lessons', 'error');
    return;
  }

  if (result.data.length === 0) {
    emptyState.classList.remove('hidden');
    return;
  }

  allLessons = result.data;
  renderLessons();
}

// Render the (sorted) lessons into the table
function renderLessons() {
  const tableContainer = document.getElementById('lessons-table-container');
  const tbody = document.getElementById('lessons-body');

  updateSortIndicators();

  const sorted = sortLessons();
  tbody.innerHTML = sorted.map(lesson => createLessonRow(lesson)).join('');
  tableContainer.classList.remove('hidden');

  sorted.forEach(lesson => {
    document.getElementById(`edit-${lesson.id}`).addEventListener('click', () => {
      window.location.href = `/teacherportal/lesson-edit/?id=${lesson.id}`;
    });
    const deleteBtn = document.getElementById(`delete-${lesson.id}`);
    if (deleteBtn) {
      deleteBtn.addEventListener('click', () => openDeleteModal(lesson));
    }
  });
}

// Create a single lesson table row
function createLessonRow(lesson) {
  const canDelete = adminUser || lesson.created_by === user.id;

  return `
    <tr>
      <td class="font-medium">${escapeHtml(displayTitle(lesson))}</td>
      <td>${escapeHtml(displayContentName(lesson)) || '—'}</td>
      <td>${escapeHtml(displayDistrict(lesson))}</td>
      <td>
        ${lesson.diagram_url
          ? `<img src="${lesson.diagram_url}" alt="Diagram" class="w-12 h-12 object-cover rounded" />`
          : `<div class="w-12 h-12 rounded bg-base-200 flex items-center justify-center text-base-content/30 text-xs">—</div>`}
      </td>
      <td class="text-right whitespace-nowrap">
        <a href="/teacherportal/lesson-show/?id=${lesson.id}" class="btn btn-sm btn-outline">View</a>
        <button id="edit-${lesson.id}" class="btn btn-sm btn-outline btn-primary">Edit</button>
        ${canDelete ? `<button id="delete-${lesson.id}" class="btn btn-sm btn-outline btn-error">Delete</button>` : ''}
      </td>
    </tr>
  `;
}

// Open delete modal
function openDeleteModal(lesson) {
  document.getElementById('delete-lesson-id').value = lesson.id;
  document.getElementById('delete-modal').showModal();
}

// Confirm delete
document.getElementById('confirm-delete-btn').addEventListener('click', async () => {
  const lessonId = document.getElementById('delete-lesson-id').value;
  
  const result = await deleteLesson(lessonId);
  
  document.getElementById('delete-modal').close();
  
  if (result.success) {
    showAlert('Lesson deleted successfully', 'success');
    loadLessons();
  } else {
    showAlert(result.error?.message || 'Failed to delete lesson', 'error');
  }
});

// Initialize
loadLessons();
</script>
