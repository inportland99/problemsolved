---
layout: minimal.njk
title: Create/Edit Lesson
description: Create or edit a math lesson
---

<div class="min-h-screen bg-base-200">
  <!-- Header -->
  <div class="navbar bg-base-100 shadow-lg">
    <div class="flex-1">
      <a href="/teacherportal/lesson-index/" class="btn btn-ghost normal-case text-xl">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Lessons
      </a>
    </div>
    <div class="flex-none gap-2">
      <span id="user-badge" class="text-sm text-base-content/70 hidden sm:inline"></span>
      <button id="logout-btn" class="btn btn-ghost btn-sm">Logout</button>
    </div>
  </div>

  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <h1 id="page-title" class="text-3xl font-bold mb-8">Create New Lesson</h1>
    
    <!-- Alert messages -->
    <div id="alert-container" class="mb-4"></div>

    <!-- Loading state (for edit mode) -->
    <div id="loading" class="hidden flex justify-center items-center py-12">
      <span class="loading loading-spinner loading-lg"></span>
    </div>

    <!-- Form -->
    <form id="lesson-form" class="space-y-6">
      <input type="hidden" id="lesson-id">

      <!-- Title -->
      <div class="form-control">
        <label class="label">
          <span class="label-text font-semibold">Title <span class="text-error">*</span></span>
        </label>
        <input type="text" id="title" class="input input-bordered" placeholder="Lesson title" required>
      </div>

      <!-- Lesson Content Name -->
      <div class="form-control">
        <label class="label">
          <span class="label-text font-semibold">Lesson Content Name</span>
        </label>
        <input type="text" id="lesson-content-name" class="input input-bordered" placeholder="Name of associated content/resource">
      </div>

      <!-- Learning Goal -->
      <div class="form-control">
        <label class="label">
          <span class="label-text font-semibold">Learning Goal <span class="text-error">*</span></span>
        </label>
        <textarea id="learning-goal" class="textarea textarea-bordered h-20" 
          placeholder="Students will understand that..." required></textarea>
      </div>

      <!-- Description -->
      <div class="form-control">
        <label class="label">
          <span class="label-text font-semibold">Description <span class="text-error">*</span></span>
        </label>
        <textarea id="task" class="textarea textarea-bordered h-32" 
          placeholder="Describe the problem or activity..." required></textarea>
      </div>

      <!-- Lesson images -->
      <div class="form-control">
        <h2 class="font-semibold mb-2">Lesson Images</h2>
        <p class="text-sm text-base-content/60 mb-2">Add diagrams or task images. The first image is the library thumbnail. Changes take effect when you save the lesson.</p>
        <div id="lesson-images-editor"></div>
      </div>

      <div class="form-control">
        <h2 class="font-semibold mb-2">Student Work</h2>
        <p class="text-sm text-base-content/60 mb-2">Group student work by implementation. Give each group a date or class/implementation label. Images are visible to anyone who can view this lesson.</p>
        <p class="text-sm text-warning mb-3">Remove student names and other identifying information before uploading.</p>
        <div id="student-work-editor"></div>
      </div>

      <!-- Launch Details -->
      <div class="form-control">
        <label class="label">
          <span class="label-text font-semibold">Launch Details</span>
        </label>
        <textarea id="launch-details" class="textarea textarea-bordered h-24" 
          placeholder="How will you introduce this task?"></textarea>
      </div>

      <!-- Anticipated Strategies -->
      <div class="form-control">
        <label class="label">
          <span class="label-text font-semibold">Anticipated Strategies</span>
        </label>
        <div class="flex flex-wrap gap-2 mb-4">
          <button type="button" class="btn btn-sm btn-outline strategy-preset" data-value="Make a table">Make a table</button>
          <button type="button" class="btn btn-sm btn-outline strategy-preset" data-value="Draw a diagram">Draw a diagram</button>
          <button type="button" class="btn btn-sm btn-outline strategy-preset" data-value="Guess/check/revise">Guess/check/revise</button>
          <button type="button" class="btn btn-sm btn-outline strategy-preset" data-value="Wishful thinking">Wishful thinking</button>
          <button type="button" class="btn btn-sm btn-outline strategy-preset" data-value="Go to extremes">Go to extremes</button>
          <button type="button" class="btn btn-sm btn-outline strategy-preset" data-value="Be creative">Be creative</button>
          <button type="button" class="btn btn-sm btn-outline strategy-preset" data-value="Solve a simpler problem">Solve a simpler problem</button>
          <button type="button" class="btn btn-sm btn-outline strategy-preset" data-value="Seek patterns/structure">Seek patterns/structure</button>
          <button type="button" class="btn btn-sm btn-ghost strategy-preset" data-value="">Other strategy</button>
        </div>
        <div id="strategies-container" class="space-y-2">
          <!-- Strategy items will be added here -->
        </div>
      </div>

      <!-- Questions -->
      <div class="form-control">
        <label class="label">
          <span class="label-text font-semibold">Questions</span>
        </label>
        <p class="text-sm text-base-content/60 mb-2">Pick a type for each question: Extension, Probing, or Connecting.</p>
        <div id="questions-container" class="space-y-2">
          <!-- Question items will be added here -->
        </div>
        <button type="button" id="add-question" class="btn btn-outline btn-sm mt-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Add Question
        </button>
      </div>

      <!-- Math Content -->
      <div class="form-control">
        <label class="label">
          <span class="label-text font-semibold">Math Content</span>
        </label>
        <p class="text-sm text-base-content/60 mb-2">Filter by Grade/Course and Domain to browse, or search by topic name, then check each Math Topic that applies. Star one selected topic to mark it primary.</p>
        <div id="taxonomy-picker-container"></div>
      </div>

      <!-- Author -->
      <div class="form-control">
        <label class="label">
          <span class="label-text font-semibold">Author <span class="text-error">*</span></span>
        </label>
        <input type="text" id="author" class="input input-bordered" placeholder="Your name" required>
      </div>

      <!-- District (populated by script based on role) -->
      <div class="form-control">
        <label class="label">
          <span class="label-text font-semibold">District</span>
        </label>
        <div id="district-field-container"></div>
      </div>

      <!-- Submit Button -->
      <div class="flex gap-4 pt-4">
        <button type="submit" id="submit-btn" class="btn btn-primary flex-1">
          <span id="submit-text">Create Lesson</span>
          <span id="submit-loading" class="loading loading-spinner hidden"></span>
        </button>
        <a href="/teacherportal/lesson-index/" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  </div>
</div>

<script type="module">
import { requireAuth, logout, isAdmin, renderUserBadge } from '/assets/js/teacher-portal-auth-guard.js';
import { getLessonById, createLesson, updateLesson } from '/assets/js/lessons-db.js';
import { createGalleryEditor } from '/assets/js/lesson-gallery-ui.mjs';
import { uploadGalleries, cleanupRemovedImages, publicLessonImageUrl } from '/assets/js/lesson-gallery-storage.mjs';
import { getAllDistricts } from '/assets/js/districts-db.js';
import { getCurrentTeacher } from '/assets/js/teachers-db.js';
import { getTaxonomy } from '/assets/js/taxonomy-db.js';
import { renderTaxonomyPicker } from '/assets/js/math-taxonomy-picker.js';

// Auth guard — redirects to login if not authenticated
const user = await requireAuth();
renderUserBadge('user-badge');

// Logout button
document.getElementById('logout-btn').addEventListener('click', logout);

let isEditMode = false;
let recoveryNeeded = false;
let saving = false;

// Get lesson ID from URL if editing
const urlParams = new URLSearchParams(window.location.search);
const lessonId = urlParams.get('id');
const saveId = lessonId || crypto.randomUUID();
const galleryEditor = createGalleryEditor(
  document.getElementById('lesson-images-editor'),
  document.getElementById('student-work-editor'),
  message => showAlert(message, 'error')
);
window.addEventListener('pagehide', event => {
  if (!event.persisted) galleryEditor.dispose();
});

// Set up the District field based on role
const adminUser = await isAdmin();
const districtsResult = await getAllDistricts();
const districts = districtsResult.success ? districtsResult.data : [];

function renderAdminDistrictSelect(selectedId = '') {
  const container = document.getElementById('district-field-container');
  container.innerHTML = `
    <select id="district-id" class="select select-bordered w-full">
      <option value="">All Districts</option>
      ${districts.map(d => `<option value="${d.id}">${d.name}</option>`).join('')}
    </select>
  `;
  document.getElementById('district-id').value = selectedId || '';
}

function renderLockedDistrictField(districtId) {
  const container = document.getElementById('district-field-container');
  const district = districts.find(d => d.id === districtId);
  container.innerHTML = `
    <input type="text" class="input input-bordered w-full" value="${district ? district.name : 'Unassigned'}" disabled>
    <input type="hidden" id="district-id" value="${districtId || ''}">
  `;
}

let ownDistrictId = null;
if (adminUser) {
  renderAdminDistrictSelect();
} else {
  const teacherResult = await getCurrentTeacher();
  ownDistrictId = teacherResult.success ? teacherResult.data.district_id : null;
  renderLockedDistrictField(ownDistrictId);
}

// Math Content tag picker
const taxonomyResult = await getTaxonomy();
const TAXONOMY = taxonomyResult.success ? taxonomyResult.data : [];
if (!taxonomyResult.success) {
  showAlert('Failed to load Math Content taxonomy options', 'error');
}
let taxonomyPicker = renderTaxonomyPicker(
  document.getElementById('taxonomy-picker-container'),
  TAXONOMY
);

// Alert helper
function showAlert(message, type = 'info') {
  const container = document.getElementById('alert-container');
  const alert = document.createElement('div');
  alert.className = `alert alert-${type} shadow-lg`;
  const span = document.createElement('span');
  span.textContent = message;
  alert.appendChild(span);
  container.appendChild(alert);
  
  setTimeout(() => {
    alert.remove();
  }, 5000);
}

// Create a removable item row
function createItemRow(containerId, value = '') {
  const container = document.getElementById(containerId);
  const row = document.createElement('div');
  row.className = 'flex gap-2';
  row.innerHTML = `
    <input type="text" class="input input-bordered flex-1 item-input" value="${escapeHtml(value)}">
    <button type="button" class="btn btn-outline btn-error btn-sm remove-item">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  `;
  
  row.querySelector('.remove-item').addEventListener('click', () => {
    row.remove();
  });
  
  container.appendChild(row);
  return row;
}

// Get all values from a container
function getItemValues(containerId) {
  const inputs = document.querySelectorAll(`#${containerId} .item-input`);
  return Array.from(inputs)
    .map(input => input.value.trim())
    .filter(val => val !== '');
}

const QUESTION_TYPES = ['extension', 'probing', 'connecting'];
const QUESTION_TYPE_LABELS = { extension: 'Extension', probing: 'Probing', connecting: 'Connecting' };

// Create a removable typed-question row
function createQuestionRow(type = 'extension', text = '') {
  const container = document.getElementById('questions-container');
  const row = document.createElement('div');
  row.className = 'flex gap-2';
  row.innerHTML = `
    <select class="select select-bordered question-type">
      ${QUESTION_TYPES.map(t => `<option value="${t}" ${t === type ? 'selected' : ''}>${QUESTION_TYPE_LABELS[t]}</option>`).join('')}
    </select>
    <input type="text" class="input input-bordered flex-1 question-text" placeholder="Question text" value="${escapeHtml(text)}">
    <button type="button" class="btn btn-outline btn-error btn-sm remove-item">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  `;

  row.querySelector('.remove-item').addEventListener('click', () => {
    row.remove();
  });

  container.appendChild(row);
  return row;
}

// Get all typed questions from the questions container
function getQuestionValues() {
  const rows = document.querySelectorAll('#questions-container > div');
  return Array.from(rows)
    .map(row => ({
      type: row.querySelector('.question-type').value,
      text: row.querySelector('.question-text').value.trim()
    }))
    .filter(q => q.text !== '');
}

// Escape HTML
function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

// Load existing lesson for editing
async function loadLesson(id) {
  document.getElementById('loading').classList.remove('hidden');
  document.getElementById('lesson-form').classList.add('hidden');
  
  const result = await getLessonById(id);
  
  document.getElementById('loading').classList.add('hidden');
  document.getElementById('lesson-form').classList.remove('hidden');
  
  if (!result.success) {
    showAlert(result.error?.message || 'Failed to load lesson', 'error');
    document.getElementById('lesson-form').inert = true;
    return;
  }
  
  const lesson = result.data;
  isEditMode = true;
  
  // Update page title and button
  document.getElementById('page-title').textContent = 'Edit Lesson';
  document.getElementById('submit-text').textContent = 'Save Changes';
  
  // Fill form
  document.getElementById('lesson-id').value = lesson.id;
  document.getElementById('title').value = lesson.title || '';
  document.getElementById('lesson-content-name').value = lesson.lesson_content_name || '';
  document.getElementById('learning-goal').value = lesson.learning_goal;
  document.getElementById('task').value = lesson.task;
  document.getElementById('launch-details').value = lesson.launch_details || '';
  document.getElementById('author').value = lesson.author;

  // District (only the admin's select is meaningfully editable)
  if (adminUser) {
    renderAdminDistrictSelect(lesson.district_id || '');
  }
  
  galleryEditor.setLesson(lesson);
  
  // Strategies
  if (lesson.anticipated_strategies?.length > 0) {
    lesson.anticipated_strategies.forEach(strategy => {
      createItemRow('strategies-container', strategy);
    });
  }
  
  // Questions
  if (lesson.questions?.length > 0) {
    lesson.questions.forEach(question => {
      createQuestionRow(question.type, question.text);
    });
  }

  // Math Content
  const existingMathContent = lesson.mathContent || [];
  const primaryEntry = existingMathContent.find(m => m.isPrimary);
  taxonomyPicker = renderTaxonomyPicker(
    document.getElementById('taxonomy-picker-container'),
    TAXONOMY,
    {
      taxonomyIds: existingMathContent.map(m => m.taxonomyId),
      primaryTaxonomyId: primaryEntry ? primaryEntry.taxonomyId : null
    }
  );
}


// Strategy preset buttons
document.querySelectorAll('.strategy-preset').forEach(btn => {
  btn.addEventListener('click', () => {
    createItemRow('strategies-container', btn.dataset.value);
  });
});

// Add question button
document.getElementById('add-question').addEventListener('click', () => {
  createQuestionRow();
});

// Form submission
document.getElementById('lesson-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  if (saving) return;
  saving = true;
  
  const submitBtn = document.getElementById('submit-btn');
  const submitText = document.getElementById('submit-text');
  const submitLoading = document.getElementById('submit-loading');
  
  // Show loading
  submitBtn.disabled = true;
  submitText.classList.add('hidden');
  submitLoading.classList.remove('hidden');
  document.getElementById('lesson-form').inert = true;
  
  try {
    // Get form values
    const title = document.getElementById('title').value.trim();
    const lessonContentName = document.getElementById('lesson-content-name').value.trim();
    const learningGoal = document.getElementById('learning-goal').value.trim();
    const task = document.getElementById('task').value.trim();
    const launchDetails = document.getElementById('launch-details').value.trim();
    const author = document.getElementById('author').value.trim();
    const districtId = document.getElementById('district-id').value || null;
    const anticipatedStrategies = getItemValues('strategies-container');
    const questions = getQuestionValues();
    const mathContentSelection = taxonomyPicker.getSelection();
    
    // Validate
    if (!title || !learningGoal || !task || !author) {
      showAlert('Please fill in all required fields', 'error');
      return;
    }
    
    const galleries = galleryEditor.getState();
    await uploadGalleries(galleries, saveId, user.id);
    const firstImage = galleries.lessonImages[0];
    const diagramUrl = firstImage ? publicLessonImageUrl(firstImage) : null;
    
    // Create or update lesson
    const lessonData = {
      id: saveId,
      title,
      lessonContentName,
      learningGoal,
      task,
      diagramUrl,
      galleries,
      launchDetails,
      anticipatedStrategies,
      questions,
      mathContentSelection,
      author,
      districtId
    };
    
    let result;
    // A previous create may have committed even if its response was lost.
    // Reuse its fixed UUID rather than creating a duplicate on retry.
    if (recoveryNeeded && !isEditMode) {
      const recovered = await getLessonById(saveId);
      if (recovered.success) isEditMode = true;
    }
    if (isEditMode) {
      result = await updateLesson(saveId, lessonData);
    } else {
      recoveryNeeded = true;
      result = await createLesson(lessonData);
    }

    // A taxonomy failure can follow a successfully saved lesson row.
    // Keep retrying that same row, and never delete files on an uncertain save.
    if (result.data) {
      isEditMode = true;
      document.getElementById('lesson-id').value = saveId;
      document.getElementById('submit-text').textContent = 'Save Changes';
    }
    
    if (result.success) {
      const warnings = await cleanupRemovedImages(galleryEditor.getCleanupBaseline(), galleries);
      if (warnings.length) {
        showAlert(`Lesson saved. ${warnings.join(' ')} You can leave this page.`, 'warning');
        return;
      }
      showAlert('Lesson saved!', 'success');
      // Keep the form locked until navigation completes.
      document.getElementById('lesson-form').dataset.saved = '1';
      // Redirect after short delay
      setTimeout(() => {
        window.location.href = '/teacherportal/lesson-index/';
      }, 1000);
    } else {
      showAlert(result.error?.message || 'Failed to save lesson', 'error');
    }
  } catch (error) {
    showAlert(error.message || 'Failed to save lesson. Your draft is still available to retry.', 'error');
  } finally {
    // Reset button
    submitBtn.disabled = false;
    submitText.classList.remove('hidden');
    submitLoading.classList.add('hidden');
    saving = false;
    document.getElementById('lesson-form').inert =
      document.getElementById('lesson-form').dataset.saved === '1';
  }
});

// Initialize
if (lessonId) {
  document.getElementById('lesson-form').inert = true;
  await loadLesson(lessonId);
  // Failed loads deliberately leave the editor locked.
  if (isEditMode) document.getElementById('lesson-form').inert = false;
}
</script>
