---
layout: minimal.njk
title: Set Password
description: Set or reset your teacher portal password
---

<div class="min-h-screen bg-base-200 flex items-center justify-center">
  <div class="container mx-auto px-4 py-8 max-w-md">
    <h1 class="text-3xl font-bold text-center mb-8">📐 Set Password</h1>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <!-- Alert messages -->
        <div id="alert-message" class="alert hidden mb-4">
          <span id="alert-text"></span>
        </div>

        <!-- Loading (waiting for the recovery/invite link's session) -->
        <div id="loading" class="flex justify-center items-center py-6">
          <span class="loading loading-spinner loading-lg"></span>
        </div>

        <!-- Set password form -->
        <form id="reset-form" class="hidden">
          <div class="form-control mb-4">
            <label class="label">
              <span class="label-text">New Password</span>
            </label>
            <input type="password" id="new-password" placeholder="••••••••"
                   class="input input-bordered" required minlength="6" />
          </div>

          <div class="form-control mb-4">
            <label class="label">
              <span class="label-text">Confirm Password</span>
            </label>
            <input type="password" id="confirm-password" placeholder="••••••••"
                   class="input input-bordered" required minlength="6" />
          </div>

          <button type="submit" class="btn btn-primary w-full">
            <span id="submit-text">Set Password</span>
            <span id="submit-spinner" class="loading loading-spinner loading-sm hidden"></span>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script type="module">
import { supabase } from '/assets/js/lessons-supabase-client.js';

function showAlert(message, type = 'error') {
  const alert = document.getElementById('alert-message');
  const alertText = document.getElementById('alert-text');

  alert.className = `alert mb-4 ${type === 'error' ? 'alert-error' : 'alert-success'}`;
  alertText.textContent = message;
  alert.classList.remove('hidden');
}

function showForm() {
  document.getElementById('loading').classList.add('hidden');
  document.getElementById('reset-form').classList.remove('hidden');
}

// If the link's token was already consumed (e.g. an email provider's link
// scanner pre-visited it before you clicked), Supabase redirects here with
// an explicit error in the query string and/or hash instead of a session.
// Surface that directly rather than showing a generic timeout message.
function paramsFrom(str) {
  const clean = str.startsWith('#') || str.startsWith('?') ? str.slice(1) : str;
  return new URLSearchParams(clean);
}

const searchParams = paramsFrom(window.location.search);
const hashParams = paramsFrom(window.location.hash);
const errorDescription = searchParams.get('error_description') || hashParams.get('error_description');
const errorCode = searchParams.get('error_code') || hashParams.get('error_code');

let sessionReady = false;

if (errorDescription) {
  document.getElementById('loading').classList.add('hidden');
  showAlert(
    `${decodeURIComponent(errorDescription.replace(/\+/g, ' '))}${errorCode ? ` (${errorCode})` : ''} Please request a new link.`,
    'error'
  );
} else {
  // Clicking an invite or password-recovery email link lands here with a
  // token in the URL. supabase-js automatically parses it and establishes a
  // temporary session, firing PASSWORD_RECOVERY (for recovery links) or
  // SIGNED_IN (for invite links) -- either way, once a session exists we can
  // let the user set a password via updateUser().
  supabase.auth.onAuthStateChange((_event, session) => {
    if (session && !sessionReady) {
      sessionReady = true;
      showForm();
    }
  });

  // Fallback in case the session was already established before the
  // listener above attached.
  const { data: { session } } = await supabase.auth.getSession();
  if (session && !sessionReady) {
    sessionReady = true;
    showForm();
  }

  // If nothing happens after a few seconds, the link was likely invalid/expired.
  setTimeout(() => {
    if (!sessionReady) {
      document.getElementById('loading').classList.add('hidden');
      showAlert('This link is invalid or has expired. Please request a new one from the login page.', 'error');
    }
  }, 4000);
}

document.getElementById('reset-form').addEventListener('submit', async (e) => {
  e.preventDefault();

  const newPassword = document.getElementById('new-password').value;
  const confirmPassword = document.getElementById('confirm-password').value;

  if (newPassword.length < 6) {
    showAlert('Password must be at least 6 characters.', 'error');
    return;
  }
  if (newPassword !== confirmPassword) {
    showAlert('Passwords do not match.', 'error');
    return;
  }

  const submitBtn = document.querySelector('#reset-form button[type="submit"]');
  const submitText = document.getElementById('submit-text');
  const submitSpinner = document.getElementById('submit-spinner');

  submitBtn.disabled = true;
  submitText.classList.add('hidden');
  submitSpinner.classList.remove('hidden');

  const { error } = await supabase.auth.updateUser({ password: newPassword });

  submitBtn.disabled = false;
  submitText.classList.remove('hidden');
  submitSpinner.classList.add('hidden');

  if (error) {
    showAlert(error.message || 'Failed to set password', 'error');
  } else {
    showAlert('Password set! Redirecting…', 'success');
    setTimeout(() => {
      window.location.href = '/teacherportal/';
    }, 1500);
  }
});
</script>
