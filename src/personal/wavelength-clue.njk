---
layout: minimal.njk
title: Wavelength - Your Clue
description: The secret target for this round.
pageCss: /assets/css/wavelength.css
permalink: /personal/wavelength/clue/index.html
---

<div class="wl-clue" id="wl-clue" data-hidden="false">

  <div class="wl-clue-empty" id="wl-clue-empty" hidden>
    <h1>No round found</h1>
    <p>Scan the QR code on the screen to see this round&rsquo;s target.</p>
  </div>

  <div class="wl-clue-card" id="wl-clue-card" hidden>
    <p class="wl-clue-round">Round <span id="wl-clue-round">1</span></p>

    <div class="wl-clue-labels">
      <span class="wl-clue-label" id="wl-clue-left">Worthless</span>
      <span class="wl-clue-label wl-clue-label--right" id="wl-clue-right">Priceless</span>
    </div>

    <div class="wl-clue-spectrum">
      <div class="wl-clue-track"></div>
      <div class="wl-clue-bands" id="wl-clue-bands"></div>
      {# Always-on midpoint reference (not the target) so the clue giver can
         judge how far left/right of center the target actually sits. #}
      <div class="wl-clue-center"></div>
      <div class="wl-clue-marker" id="wl-clue-marker"></div>
    </div>

    <p class="wl-clue-hint">Your target is the bullseye. Give a clue that lands there.</p>

    <button type="button" class="wl-clue-hide" id="wl-clue-hide">CLUE GIVEN</button>

    <p class="wl-clue-hidden-note">Target hidden. Let the room decide.</p>
  </div>

</div>

<script type="module">
  {# CACHE-BUSTING: keep this ?v= in sync with the imports in clue.js. #}
  import { initClue } from '/assets/js/wavelength/clue.js?v=5';

  try {
    initClue(document.getElementById('wl-clue'));
  } catch (error) {
    console.error('[wavelength] Clue view failed to start:', error);
    document.getElementById('wl-clue-empty').hidden = false;
  }
</script>
