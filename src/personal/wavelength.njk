---
layout: minimal.njk
title: Wavelength
description: A party game of guessing where a clue falls on a spectrum.
pageCss: /assets/css/wavelength.css
---

<div class="wl-board" id="wl-board" data-revealed="false">

  <header class="wl-topbar">
    <div class="wl-round-chip">Round <span id="wl-round">1</span></div>
    <div class="wl-brand">Wavelength</div>
    <div class="wl-topbar-spacer"></div>
  </header>

  <main class="wl-stage">
    <div class="wl-label wl-label--left" id="wl-left-label">Worthless</div>

    <div class="wl-gauge-wrap">
      <svg id="wl-gauge" class="wl-gauge" viewBox="0 0 1000 560" role="img"
           aria-label="Spectrum dial with a movable needle">
        <defs>
          {# Clips the rotating screen below (see .wl-screen) to the dial's
             own visible half, so the swept-away portion doesn't bleed down
             into the score/footer area as it spins past the hub. #}
          <clipPath id="wl-dial-clip">
            <rect x="0" y="0" width="1000" height="500"></rect>
          </clipPath>
        </defs>

        <path id="wl-track" class="wl-track"></path>
        {# The color wedges sit statically in their true position from the
           moment they're drawn — they never move or fade. What performs the
           reveal is .wl-screen just below: an opaque panel, the same shape
           and color as the empty track, that starts directly on top of the
           bands (so pre-reveal it looks identical to a plain empty dial)
           and rotates 180deg clockwise around the needle's pivot, sweeping
           away left-to-right like the physical game's sliding cover. #}
        <g id="wl-bands" class="wl-bands">
          <g id="wl-bands-content"></g>
          <line id="wl-target-line" class="wl-target-line"></line>
        </g>
        <g clip-path="url(#wl-dial-clip)">
          <path id="wl-screen" class="wl-screen"></path>
        </g>
        <g id="wl-ticks" class="wl-ticks"></g>
        <g id="wl-needle" class="wl-needle">
          <path class="wl-needle-shape" d="M 500 14 L 514 452 L 500 516 L 486 452 Z"></path>
        </g>
        <circle class="wl-hub" cx="500" cy="500" r="34"></circle>
        <circle class="wl-hub-dot" cx="500" cy="500" r="12"></circle>

        {# Score lives inside the SVG so it stays locked to the dial no
           matter how the drawing is scaled or letterboxed. #}
        <g id="wl-score" class="wl-score" aria-live="polite">
          <rect id="wl-score-bg" class="wl-score-bg" width="0" height="0"></rect>
          <text id="wl-score-text" class="wl-score-text" x="500" y="380"></text>
        </g>
      </svg>
    </div>

    <div class="wl-label wl-label--right" id="wl-right-label">Priceless</div>
  </main>

  <footer class="wl-footer">
    <div class="wl-controls">
      <button type="button" class="wl-btn" id="wl-btn-left" aria-label="Move needle left">&#9664;</button>
      <button type="button" class="wl-btn" id="wl-btn-right" aria-label="Move needle right">&#9654;</button>
      <button type="button" class="wl-btn wl-btn--wide" id="wl-btn-reveal">Reveal</button>
      <button type="button" class="wl-btn wl-btn--wide" id="wl-btn-next">Next</button>
    </div>
    <p class="wl-keyhints">
      <kbd>&larr;</kbd><kbd>&rarr;</kbd> move
      <span>&middot;</span> <kbd>Shift</kbd> fine
      <span>&middot;</span> <kbd>Space</kbd> reveal
      <span>&middot;</span> <kbd>N</kbd> next
      <span>&middot;</span> <kbd>R</kbd> reroll
      <span>&middot;</span> <kbd>F</kbd> fullscreen
      <span>&middot;</span> <kbd>Q</kbd> qr
    </p>
  </footer>

  <aside class="wl-qr-panel" id="wl-qr-panel" title="Scan to give the clue (press Q to enlarge)">
    <div class="wl-qr" id="wl-qr"></div>
    <p class="wl-qr-caption">Scan to give the clue</p>
  </aside>

</div>

<script type="module">
  {# CACHE-BUSTING: keep this ?v= in sync with the imports in board.js. #}
  import { initBoard } from '/assets/js/wavelength/board.js?v=5';

  try {
    initBoard(document.getElementById('wl-board'));
  } catch (error) {
    console.error('[wavelength] Board failed to start:', error);
    document.getElementById('wl-board').insertAdjacentHTML(
      'afterbegin',
      '<p class="wl-fatal">The board failed to start. Check the browser console for details.</p>'
    );
  }
</script>
